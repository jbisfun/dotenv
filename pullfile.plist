<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>identity</key>
	<dict>
		<key>email</key>
		<string>none</string>
		<key>require_signing</key>
		<false/>
	</dict>
	<key>env</key>
	<dict>
		<key>path</key>
		<array>
			<string>~/.local/go/bin</string>
			<string>~/.cargo/bin</string>
			<string>ycode/crates/lua_hooks</string>
		</array>
		<key>vars</key>
		<dict>
			<key>GOTOOLCHAIN</key>
			<string>local</string>
			<key>YCODE_HOOKS</key>
			<string>~/.config/zed/hooks</string>
		</dict>
	</dict>
	<key>lint</key>
	<dict>
		<key>no_description</key>
		<true/>
		<key>max_subject_length</key>
		<integer>40</integer>
		<key>conventional</key>
		<false/>
		<key>no_trailing_period</key>
		<false/>
	</dict>
	<key>hooks</key>
	<dict>
		<key>precommit</key>
		<array>
			<string>cp "$PULL_ROOT/pullfile.plist" "$PULL_ROOT/dotenv/pullfile.plist" &amp;&amp; git -C "$PULL_ROOT/dotenv" add pullfile.plist</string>
		</array>
		<key>postcommit</key>
		<array/>
		<key>pull</key>
		<array/>
	</dict>
	<key>repos</key>
	<array>
		<dict>
			<key>name</key>
			<string>pull</string>
			<key>upstream</key>
			<string>https://github.com/jbisfun/pull.git</string>
			<key>branch</key>
			<string>main</string>
			<key>commit</key>
			<string>f81f396592dc8a2bcb697e49b16b0b4cd6fe9e9e</string>
		</dict>
		<dict>
			<key>name</key>
			<string>ycode</string>
			<key>upstream</key>
			<string>https://github.com/jbisfun/ycode.git</string>
			<key>branch</key>
			<string>main</string>
			<key>commit</key>
			<string>5d449cc3e2b251dba30829b8729e91325080c103</string>
		</dict>
		<dict>
			<key>name</key>
			<string>dotenv</string>
			<key>upstream</key>
			<string>https://github.com/jbisfun/dotenv.git</string>
			<key>branch</key>
			<string>main</string>
		</dict>
	</array>
</dict>
</plist>
